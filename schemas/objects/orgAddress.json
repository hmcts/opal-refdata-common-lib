{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "v2.5/1.5.2/objects/orgAddress.json",
  "title": "Address (Organisation)",
  "type": "object",
  "properties": {
    "address_line_1": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 35
    },
    "address_line_2": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 35
    },
    "address_line_3": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 35
    },
    "address_line_4": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 35
    },
    "address_line_5": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 35
    },
    "postcode": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 8,
      "pattern": "^((?: *[Gg] *[Ii] *[Rr] *0 *[Aa] *[Aa]|(?: *[A-Za-z]){1,2} *[0-9](?: *[0-9A-Za-z])? *[0-9](?: *[AaBbDdEeFfGgHhJjLlNnPpQqRrSsTtUuWwXxYyZz]){2})) *$"
    },
    "address_type": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 100
    }
  },
  "required": [],
  "additionalProperties": false
}
