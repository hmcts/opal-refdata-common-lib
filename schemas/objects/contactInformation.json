{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "v2.5/1.5.2/objects/contactInformation.json",
  "title": "Contact information",
  "type": "object",
  "properties": {
    "contact_type": {
      "type": "string",
      "enum": [
        "Mobile",
        "Destination ID",
        "Telephone",
        "Fax",
        "Email Address"
      ],
      "maxLength": 30
    },
    "contact_value": {
      "type": "string",
      "maxLength": 254
    }
  },
  "required": [
    "contact_value",
    "contact_type"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "$comment": "Court:ContactInformation.ContactValueValidation",
      "anyOf": [
        {
          "properties": {
            "contact_type": {
              "allOf": [
                {
                  "not": {
                    "enum": [
                      "Email Address",
                      "Telephone",
                      "Fax"
                    ]
                  }
                },
                {
                  "not": {
                    "type": "null"
                  }
                }
              ]
            }
          },
          "required": [
            "contact_type"
          ]
        },
        {
          "required": [
            "contact_type"
          ],
          "properties": {
            "contact_type": {
              "const": "Email Address"
            },
            "contact_value": {
              "pattern": "^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}$",
              "maxLength": 254
            }
          }
        },
        {
          "required": [
            "contact_type"
          ],
          "properties": {
            "contact_type": {
              "const": "Telephone"
            },
            "contact_value": {
              "maxLength": 254
            }
          }
        },
        {
          "required": [
            "contact_type"
          ],
          "properties": {
            "contact_type": {
              "const": "Fax"
            },
            "contact_value": {
              "maxLength": 14
            }
          }
        }
      ]
    }
  ]
}
