{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "published-reference-data-message.schema.json",
  "title": "Published Reference Data Message",
  "type": "object",
  "properties": {
    "header": {
      "type": "object",
      "properties": {
        "message_id": {
          "type": "string",
          "format": "uuid"
        },
        "message_type": {
          "const": "ReferenceData"
        },
        "data_product": {
          "type": "string",
          "enum": ["Offence", "Court", "LJA", "Prison", "Enforcer", "CentralAuthority", "MajorCreditor"]
        },
        "operation": {
          "const": "PUBLISH"
        },
        "source_system": {
          "const": "Semarchy"
        },
        "created_date_time": {
          "type": "string",
          "format": "date-time"
        },
        "release_package_id": {
          "type": "integer"
        },
        "record_count": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": ["message_id", "message_type", "data_product", "operation", "source_system", "created_date_time", "release_package_id", "record_count"],
      "additionalProperties": false
    },
    "payload": {
      "type": "object",
      "properties": {
        "records": {
          "type": "array",
          "minItems": 1
        }
      },
      "required": ["records"],
      "additionalProperties": false
    }
  },
  "required": ["header", "payload"],
  "oneOf": [
    {
      "title": "Offence message",
      "properties": {
        "header": {
          "properties": {
            "data_product": {
              "const": "Offence"
            }
          }
        },
        "payload": {
          "properties": {
            "records": {
              "items": {
                "$ref": "#/$defs/offenceRecord"
              }
            }
          }
        }
      }
    },
    {
      "title": "Court message",
      "properties": {
        "header": {
          "properties": {
            "data_product": {
              "const": "Court"
            }
          }
        },
        "payload": {
          "properties": {
            "records": {
              "items": {
                "$ref": "#/$defs/courtRecord"
              }
            }
          }
        }
      }
    },
    {
      "title": "LJA message",
      "properties": {
        "header": {
          "properties": {
            "data_product": {
              "const": "LJA"
            }
          }
        },
        "payload": {
          "properties": {
            "records": {
              "items": {
                "$ref": "#/$defs/ljaRecord"
              }
            }
          }
        }
      }
    },
    {
      "title": "Prison message",
      "properties": {
        "header": {
          "properties": {
            "data_product": {
              "const": "Prison"
            }
          }
        },
        "payload": {
          "properties": {
            "records": {
              "items": {
                "$ref": "#/$defs/prisonRecord"
              }
            }
          }
        }
      }
    },
    {
      "title": "Enforcer message",
      "properties": {
        "header": {
          "properties": {
            "data_product": {
              "const": "Enforcer"
            }
          }
        },
        "payload": {
          "properties": {
            "records": {
              "items": {
                "$ref": "#/$defs/enforcerRecord"
              }
            }
          }
        }
      }
    },
    {
      "title": "CentralAuthority message",
      "properties": {
        "header": {
          "properties": {
            "data_product": {
              "const": "CentralAuthority"
            }
          }
        },
        "payload": {
          "properties": {
            "records": {
              "items": {
                "$ref": "#/$defs/centralAuthorityRecord"
              }
            }
          }
        }
      }
    },
    {
      "title": "MajorCreditor message",
      "properties": {
        "header": {
          "properties": {
            "data_product": {
              "const": "MajorCreditor"
            }
          }
        },
        "payload": {
          "properties": {
            "records": {
              "items": {
                "$ref": "#/$defs/majorCreditorRecord"
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "offenceRecord": {
      "title": "Offence record",
      "type": "object",
      "properties": {
        "cjs_code": {
          "type": "string",
          "maxLength": 8,
          "not": {
            "pattern": "[^A-Za-z0-9]"
          },
          "x-unique-keys": [
            {
              "name": "CJSCodeUniqueKey"
            }
          ]
        },
        "cjs_title": {
          "type": "string",
          "maxLength": 120
        },
        "second_language_cjs_title": {
          "type": ["string", "null"],
          "maxLength": 120
        },
        "user_acts_and_section": {
          "type": ["string", "null"],
          "maxLength": 4000
        },
        "second_language_offence_act_and_section_text": {
          "type": ["string", "null"],
          "maxLength": 4000
        },
        "date_used_from": {
          "type": "string",
          "format": "date"
        },
        "date_used_to": {
          "type": ["string", "null"],
          "format": "date",
          "x-rules": [
            {
              "name": "DateUsedToGEDateUsedFromValidation",
              "op": ">=",
              "right": "date_used_from",
              "compare_as": "date"
            }
          ]
        },
        "recordable": {
          "type": "string",
          "enum": ["Yes", "No"]
        },
        "reportable": {
          "type": "string",
          "enum": ["Yes", "No"]
        },
        "standard_list": {
          "type": "string",
          "enum": ["Yes", "No"]
        },
        "traffic_control": {
          "type": ["boolean", "null"]
        },
        "dvla_code": {
          "type": ["string", "null"],
          "maxLength": 4
        },
        "offence_notes": {
          "type": ["string", "null"],
          "maxLength": 4000
        },
        "maximum_penalty": {
          "type": ["string", "null"],
          "maxLength": 100
        },
        "description": {
          "type": ["string", "null"],
          "maxLength": 250
        },
        "derived_from_cjs_code": {
          "type": ["string", "null"],
          "maxLength": 10
        },
        "ho_class": {
          "type": ["integer", "null"],
          "minimum": -9999999,
          "maximum": 99999999
        },
        "ho_sub_class": {
          "type": ["integer", "null"],
          "minimum": -9999999,
          "maximum": 99999999
        },
        "proceedings_code": {
          "type": ["integer", "null"],
          "exclusiveMaximum": 100
        },
        "pnld_standard_offence_wording": {
          "type": ["string", "null"],
          "maxLength": 4000
        },
        "pnld_welsh_standard_offence_wording": {
          "type": ["string", "null"],
          "maxLength": 4000
        },
        "pnld_date_of_last_update": {
          "type": ["string", "null"],
          "format": "date"
        },
        "pnld_prosecution_time_limit": {
          "type": ["string", "null"],
          "maxLength": 40
        },
        "pnld_max_fine_type_magistrates_court": {
          "type": ["string", "null"],
          "maxLength": 1
        },
        "pnld_max_fine_type_magistrates_court_description": {
          "type": ["string", "null"],
          "maxLength": 1000
        },
        "pnld_mode_of_trial": {
          "type": ["string", "null"],
          "maxLength": 50
        },
        "pnld_endorsable_flag": {
          "type": ["string", "null"],
          "enum": ["N", "Y", null]
        },
        "pnld_location_flag": {
          "type": ["string", "null"],
          "enum": ["N", "Y", null]
        },
        "pnld_principal_offence_category": {
          "type": ["string", "null"],
          "maxLength": 200
        },
        "user_offence_wording": {
          "type": ["string", "null"],
          "maxLength": 4000
        },
        "user_statement_of_facts": {
          "type": ["string", "null"],
          "maxLength": 4000
        },
        "entry_prompt_substitution_sow": {
          "type": ["string", "null"],
          "maxLength": 4000
        },
        "entry_prompt_substitution_sof": {
          "type": ["string", "null"],
          "maxLength": 4000
        },
        "entry_prompt_substitution_ans": {
          "type": ["string", "null"],
          "maxLength": 4000
        },
        "area": {
          "type": ["integer", "null"]
        },
        "blocked": {
          "type": ["string", "null"],
          "enum": ["N", "Y", null]
        },
        "second_language_offence_statement_of_facts_text": {
          "type": ["string", "null"],
          "maxLength": 4000
        },
        "second_language_offence_wording_text": {
          "type": ["string", "null"],
          "maxLength": 4000
        },
        "offence_code": {
          "type": ["integer", "null"]
        },
        "pnld_offence_start_date": {
          "type": ["string", "null"],
          "format": "date"
        },
        "pnld_offence_end_date": {
          "type": ["string", "null"],
          "format": "date"
        },
        "sow_reference": {
          "type": ["string", "null"],
          "maxLength": 10
        },
        "publishing_status": {
          "type": ["string", "null"],
          "enum": ["Not Published", "Active", "Submitted", "Added to Release Package", "Inactive", "Error", "Future", "Superseded", null]
        },
        "offence_source": {
          "type": "string",
          "enum": ["NSD", "PNLD", "APPS", "MOJ"]
        },
        "mis_classification": {
          "type": ["string", "null"],
          "enum": ["DRU", "FRF", "THG", "VAP", "IMO", "FTS", "DDR", "SNM", "OSM", "DAM", "SEX", "DWC", "XXX", "ROB", "BUR", null]
        },
        "offence_class": {
          "type": "string",
          "enum": ["1", "3", "2", "S"]
        },
        "can_be_bulk": {
          "type": ["boolean", "null"]
        },
        "initial_fee_applicable": {
          "type": ["boolean", "null"]
        },
        "contested_fee": {
          "type": ["boolean", "null"]
        },
        "application_synonym": {
          "type": ["string", "null"],
          "enum": ["AS MOJ", "DEFENDANT", "TRUE", "AS Text", "FALSE", "Applicant", "APPLICANT", null]
        },
        "exparte": {
          "type": ["boolean", "null"]
        },
        "jurisdiction": {
          "type": ["string", "null"],
          "enum": ["EITHER", "CROWN", "MAGISTRATES", null]
        },
        "appeal_flag": {
          "type": ["boolean", "null"]
        },
        "summons_template_type": {
          "type": ["string", "null"],
          "enum": ["BREACH", "FIRST_HEARING", "PARENT_GENERIC_CASE", "GENERIC_APPLICATION", "NOT_APPLICABLE", null]
        },
        "link_type": {
          "type": ["string", "null"],
          "enum": ["FIRST_HEARING", "STANDALONE", "SJP", "LINKED", null]
        },
        "hearing_code": {
          "type": ["string", "null"],
          "maxLength": 10
        },
        "applicant_appellant_flag": {
          "type": ["string", "null"],
          "enum": ["Appellant", "Applicant", null]
        },
        "plea_applicable_flag": {
          "type": ["boolean", "null"]
        },
        "active_offence_order": {
          "type": ["string", "null"],
          "enum": ["NOT_APPLICABLE", "OFFENCE", "COURT_ORDER", null]
        },
        "commissioner_of_oath": {
          "type": ["boolean", "null"]
        },
        "breach_type": {
          "type": ["string", "null"],
          "enum": ["COMMISSION_OF_NEW_OFFENCE_BREACH", "NOT_APPLICABLE", "GENERIC_BREACH", null]
        },
        "court_of_appeal_flag": {
          "type": ["boolean", "null"]
        },
        "court_extract_available": {
          "type": ["boolean", "null"]
        },
        "listing_notification_template": {
          "type": ["string", "null"],
          "enum": ["POSTAL_NOTIFICATION", "TRUE", "NOT_APPLICABLE", null]
        },
        "boxwork_notification_template": {
          "type": ["string", "null"],
          "maxLength": 19
        },
        "prosecutor_as_third_party_flag": {
          "type": ["boolean", "null"]
        },
        "resentencing_activation_code": {
          "type": ["string", "null"],
          "maxLength": 10
        },
        "prefix": {
          "type": ["string", "null"],
          "maxLength": 100
        },
        "obsolete_indicator": {
          "type": "string",
          "enum": ["N", "Y"]
        },
        "custodial_indicator": {
          "type": "string",
          "enum": ["Yes", "No"]
        }
      },
      "required": ["cjs_title", "cjs_code", "offence_source", "offence_class", "standard_list", "recordable", "reportable", "obsolete_indicator", "custodial_indicator", "date_used_from"],
      "additionalProperties": false,
      "allOf": [
        {
          "$comment": "Offence:OffenceRevision.CivilAppDataMandatoryFieldValidation",
          "if": {
            "properties": {
              "offence_source": {
                "const": "APPS"
              }
            }
          },
          "then": {
            "required": ["jurisdiction", "hearing_code", "link_type", "active_offence_order", "summons_template_type", "breach_type"],
            "properties": {
              "jurisdiction": {
                "not": {
                  "type": "null"
                }
              },
              "hearing_code": {
                "not": {
                  "type": "null"
                }
              },
              "link_type": {
                "not": {
                  "type": "null"
                }
              },
              "active_offence_order": {
                "not": {
                  "type": "null"
                }
              },
              "summons_template_type": {
                "not": {
                  "type": "null"
                }
              },
              "breach_type": {
                "not": {
                  "type": "null"
                }
              }
            }
          }
        }
      ]
    },
    "courtRecord": {
      "title": "Court record",
      "type": "object",
      "properties": {
        "court_name": {
          "type": "string",
          "maxLength": 100
        },
        "court_welsh_name": {
          "type": ["string", "null"],
          "maxLength": 100
        },
        "court_location_code": {
          "type": "string",
          "maxLength": 10,
          "$comment": "Court:Court.CourtLocationCodeCrownValidation | CourtLocationCodeMagistratesValidation (per stepper)",
          "if": {
            "pattern": "^C"
          },
          "then": {
            "pattern": "^C(?:01|03|04|05|06|07|10|11|12|13|14|16|17|20|21|22|23|30|31|32|33|34|35|36|37|40|41|42|43|44|45|46|47|50|52|53|54|55|60|61|62|63)[A-Z]{2}\\d{2}$"
          },
          "else": {
            "pattern": "^B(?:01|03|04|05|06|07|10|11|12|13|14|16|17|20|21|22|23|30|31|32|33|34|35|36|37|40|41|42|43|44|45|46|47|50|52|53|54|55|60|61|62|63)[A-Z]{2}\\d{2}$"
          },
          "x-unique-keys": [
            {
              "name": "CourtLocationCodeUniqueKey"
            }
          ]
        },
        "start_date": {
          "type": "string",
          "format": "date"
        },
        "end_date": {
          "type": ["string", "null"],
          "format": "date",
          "x-rules": [
            {
              "name": "EndDateNotEarlierThanStartDate",
              "op": ">=",
              "right": "start_date",
              "compare_as": "date"
            }
          ]
        },
        "cja_code": {
          "type": "string",
          "enum": ["41", "53", "55", "13", "60", "04", "35", "06", "40", "16", "03", "44", "21", "62", "07", "30", "42", "33", "50", "45", "36", "22", "17", "12", "54", "46", "47", "31", "10", "63", "01", "23", "52", "37", "34", "11", "61", "05", "14", "32", "43", "20"]
        },
        "division_code": {
          "type": ["string", "null"],
          "enum": ["4", "6", "1", "5", "2", "7", "3", null]
        },
        "default_start_time": {
          "type": ["string", "null"],
          "maxLength": 10,
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]$"
        },
        "default_duration": {
          "type": ["string", "null"],
          "maxLength": 10,
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]$"
        },
        "common_platform_uuid": {
          "type": ["string", "null"],
          "format": "uuid"
        },
        "notes": {
          "type": ["string", "null"],
          "maxLength": 4000
        },
        "publishing_status": {
          "type": "string",
          "enum": ["Superseded", "Future", "Active", "Inactive", "Submitted", "Not Published", "Added to Release Package", "Error"]
        },
        "addresses": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/address"
          },
          "allOf": [
            {
              "contains": {
                "properties": {
                  "address_type": {
                    "const": "Court Address"
                  }
                },
                "required": ["address_type"]
              },
              "minContains": 1,
              "maxContains": 1
            }
          ]
        },
        "contact_information": {
          "type": ["array", "null"],
          "items": {
            "$ref": "#/$defs/contactInformation"
          }
        }
      },
      "required": ["court_name", "start_date", "publishing_status", "cja_code", "addresses", "court_location_code"],
      "additionalProperties": false,
      "allOf": [
        {
          "$comment": "Court:Court.WelshCourtAddressCountValidation",
          "if": {
            "required": ["court_welsh_name"],
            "properties": {
              "court_welsh_name": {
                "not": {
                  "type": "null"
                }
              }
            }
          },
          "then": {
            "properties": {
              "addresses": {
                "contains": {
                  "properties": {
                    "address_type": {
                      "const": "Welsh Court Address"
                    }
                  },
                  "required": ["address_type"]
                },
                "minContains": 1,
                "maxContains": 1
              }
            }
          },
          "else": {
            "properties": {
              "addresses": {
                "not": {
                  "contains": {
                    "properties": {
                      "address_type": {
                        "const": "Welsh Court Address"
                      }
                    },
                    "required": ["address_type"]
                  }
                }
              }
            }
          }
        }
      ]
    },
    "ljaRecord": {
      "title": "LJA record",
      "type": "object",
      "properties": {
        "lja_code": {
          "type": "string",
          "maxLength": 4,
          "$comment": "Court:Court.CourtCodeValidation",
          "pattern": "^[0-9]+$",
          "minLength": 4,
          "x-unique-keys": [
            {
              "name": "CourtCodeUniqueKey"
            }
          ]
        },
        "lja_name": {
          "type": "string",
          "maxLength": 100
        },
        "court_short_name": {
          "type": ["string", "null"],
          "maxLength": 200
        },
        "lja_welsh_name": {
          "type": ["string", "null"],
          "maxLength": 100
        },
        "lja_type": {
          "type": "string",
          "enum": ["PSA", "NICRT", "YCT", "SCSCRT", "SJCRT", "CRWCRT"]
        },
        "lja_location_code": {
          "type": ["string", "null"],
          "maxLength": 10
        },
        "start_date": {
          "type": "string",
          "format": "date"
        },
        "end_date": {
          "type": ["string", "null"],
          "format": "date",
          "x-rules": [
            {
              "name": "EndDateNotEarlierThanStartDate",
              "op": ">=",
              "right": "start_date",
              "compare_as": "date"
            }
          ]
        },
        "cja_code": {
          "type": ["string", "null"],
          "enum": ["41", "53", "55", "13", "60", "04", "35", "06", "40", "16", "03", "44", "21", "62", "07", "30", "42", "33", "50", "45", "36", "22", "17", "12", "54", "46", "47", "31", "10", "63", "01", "23", "52", "37", "34", "11", "61", "05", "14", "32", "43", "20", null]
        },
        "division_code": {
          "type": ["string", "null"],
          "enum": ["4", "6", "1", "5", "2", "7", "3", null]
        },
        "default_start_time": {
          "type": ["string", "null"],
          "maxLength": 10,
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]$"
        },
        "default_duration": {
          "type": ["string", "null"],
          "maxLength": 10,
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]$"
        },
        "common_platform_uuid": {
          "type": ["string", "null"],
          "format": "uuid"
        },
        "notes": {
          "type": ["string", "null"],
          "maxLength": 4000
        },
        "publishing_status": {
          "type": "string",
          "enum": ["Superseded", "Future", "Active", "Inactive", "Submitted", "Not Published", "Added to Release Package", "Error"]
        },
        "addresses": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/address"
          },
          "allOf": [
            {
              "contains": {
                "properties": {
                  "address_type": {
                    "const": "Court Address"
                  }
                },
                "required": ["address_type"]
              },
              "minContains": 1,
              "maxContains": 1
            }
          ]
        },
        "contact_information": {
          "type": ["array", "null"],
          "items": {
            "$ref": "#/$defs/contactInformation"
          }
        }
      },
      "required": ["lja_type", "lja_name", "start_date", "publishing_status", "addresses", "lja_code"],
      "additionalProperties": false,
      "allOf": [
        {
          "$comment": "Court:Court.CourtLocationCodeValidation (per stepper)",
          "if": {
            "properties": {
              "lja_type": {
                "enum": ["CRWCRT"]
              }
            }
          },
          "then": {
            "properties": {
              "lja_location_code": {
                "pattern": "^[A-Z](?:01|02|03|04|05|06|07|10|11|12|13|14|16|17|20|21|22|23|30|31|32|33|34|35|36|37|40|41|42|43|44|45|46|47|48|50|52|53|54|55|60|61)[A-Z]{2}\\d{2}$"
              }
            }
          }
        }
      ]
    },
    "prisonRecord": {
      "title": "Prison record",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 4000,
          "x-unique-keys": [
            {
              "name": "PrisonsUniqueKey"
            }
          ]
        },
        "welsh_name": {
          "type": ["string", "null"],
          "maxLength": 4000
        },
        "start_date": {
          "type": "string",
          "format": "date"
        },
        "end_date": {
          "type": ["string", "null"],
          "format": "date",
          "x-rules": [
            {
              "name": "EndDateNotEarlierThanStartDateValidation",
              "op": ">=",
              "right": "start_date",
              "compare_as": "date"
