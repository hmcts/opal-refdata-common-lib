{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["header", "payload"],
  "properties": {
    "header": {
      "type": "object",
      "required": ["data_product"],
      "properties": {
        "data_product": {"type": "string", "minLength": 1}
      }
    },
    "payload": {
      "type": "object",
      "required": ["records"],
      "properties": {
        "records": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "code", "name", "description", "active"],
            "properties": {
              "id": {"type": "integer"},
              "code": {"type": "string"},
              "name": {"type": "string"},
              "description": {"type": "string"},
              "active": {"type": "boolean"}
            }
          }
        }
      }
    }
  }
}
