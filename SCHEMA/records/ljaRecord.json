{
  "title": "LJA record",
  "type": "object",
  "properties": {
    "lja_code": {
      "type": "string",
      "maxLength": 4,
      "$comment": "Court:Court.CourtCodeValidation",
      "pattern": "^[0-9]+$",
      "minLength": 4,
      "x-unique-keys": [
        {
          "name": "CourtCodeUniqueKey",
          "when": {
            "lja_type": [
              "PSA",
              "NICRT",
              "YCT",
              "SCSCRT",
              "SJCRT",
              "CRWCRT"
            ]
          }
        }
      ]
    },
    "lja_name": {
      "type": "string",
      "maxLength": 100
    },
    "court_short_name": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 200
    },
    "lja_welsh_name": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 100
    },
    "lja_type": {
      "type": "string",
      "enum": [
        "PSA",
        "NICRT",
        "YCT",
        "SCDCRT",
        "SCSCRT",
        "SJCRT",
        "CRWCRT"
      ]
    },
    "lja_location_code": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 10,
      "x-unique-keys": [
        {
          "name": "CourtLocationCodeUniqueKey",
          "when": {
            "lja_type": [
              "CRWCRT"
            ]
          }
        }
      ]
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "end_date": {
      "type": [
        "string",
        "null"
      ],
      "format": "date",
      "x-rules": [
        {
          "name": "EndDateNotEarlierThanStartDate",
          "op": ">=",
          "right": "start_date",
          "compare_as": "date",
          "when": {
            "lja_type": [
              "PSA",
              "NICRT",
              "YCT",
              "SCSCRT",
              "SJCRT",
              "CRWCRT"
            ]
          }
        }
      ]
    },
    "cja_code": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "41",
        "53",
        "55",
        "13",
        "60",
        "04",
        "35",
        "06",
        "40",
        "16",
        "03",
        "44",
        "21",
        "62",
        "07",
        "30",
        "42",
        "33",
        "50",
        "45",
        "36",
        "22",
        "17",
        "12",
        "54",
        "46",
        "47",
        "31",
        "10",
        "63",
        "01",
        "23",
        "52",
        "37",
        "34",
        "11",
        "61",
        "05",
        "14",
        "32",
        "43",
        "20",
        null
      ]
    },
    "division_code": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "4",
        "6",
        "1",
        "5",
        "2",
        "7",
        "3",
        null
      ]
    },
    "default_start_time": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 10,
      "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]$"
    },
    "default_duration": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 10,
      "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]$"
    },
    "common_platform_uuid": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "notes": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 4000
    },
    "publishing_status": {
      "type": "string",
      "enum": [
        "Superseded",
        "Future",
        "Active",
        "Inactive",
        "Submitted",
        "Not Published",
        "Added to Release Package",
        "Error"
      ]
    },
    "addresses": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "#/$defs/address"
      }
    },
    "contact_information": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "#/$defs/contactInformation"
      }
    }
  },
  "required": [
    "lja_type",
    "lja_name",
    "start_date",
    "publishing_status",
    "lja_code"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "lja_type": {
            "enum": [
              "PSA",
              "YCT",
              "CRWCRT"
            ]
          }
        }
      },
      "then": {
        "required": [
          "cja_code"
        ],
        "properties": {
          "cja_code": {
            "not": {
              "type": "null"
            }
          }
        }
      }
    },
    {
      "$comment": "Court:Court.CourtLocationCodeValidation (per stepper)",
      "if": {
        "properties": {
          "lja_type": {
            "enum": [
              "CRWCRT"
            ]
          }
        }
      },
      "then": {
        "required": [
          "lja_location_code"
        ],
        "properties": {
          "lja_location_code": {
            "pattern": "^[A-Z](?:01|02|03|04|05|06|07|10|11|12|13|14|16|17|20|21|22|23|30|31|32|33|34|35|36|37|40|41|42|43|44|45|46|47|48|50|52|53|54|55|60|61)[A-Z]{2}\\d{2}$",
            "not": {
              "type": "null"
            }
          }
        }
      }
    },
    {
      "$comment": "Court:Court.CourtAddressCountValidation | FinancialOfficeAddressCountValidation | WelshCourtAddressCountValidation",
      "if": {
        "properties": {
          "lja_type": {
            "enum": [
              "PSA",
              "YCT"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "addresses": {
            "minItems": 2,
            "allOf": [
              {
                "contains": {
                  "properties": {
                    "address_type": {
                      "const": "Financial Office Address"
                    }
                  },
                  "required": [
                    "address_type"
                  ]
                },
                "minContains": 1,
                "maxContains": 1
              },
              {
                "contains": {
                  "properties": {
                    "address_type": {
                      "const": "Court Address"
                    }
                  },
                  "required": [
                    "address_type"
                  ]
                },
                "minContains": 1,
                "maxContains": 1
              }
            ],
            "not": {
              "type": "null"
            }
          }
        },
        "required": [
          "addresses"
        ],
        "allOf": [
          {
            "$comment": "Court:Court.WelshCourtAddressCountValidation",
            "if": {
              "required": [
                "lja_welsh_name"
              ],
              "properties": {
                "lja_welsh_name": {
                  "not": {
                    "type": "null"
                  }
                }
              }
            },
            "then": {
              "properties": {
                "addresses": {
                  "contains": {
                    "properties": {
                      "address_type": {
                        "const": "Welsh Court Address"
                      }
                    },
                    "required": [
                      "address_type"
                    ]
                  },
                  "minContains": 1,
                  "maxContains": 1,
                  "not": {
                    "type": "null"
                  }
                }
              },
              "required": [
                "addresses"
              ]
            },
            "else": {
              "properties": {
                "addresses": {
                  "not": {
                    "contains": {
                      "properties": {
                        "address_type": {
                          "const": "Welsh Court Address"
                        }
                      },
                      "required": [
                        "address_type"
                      ]
                    }
                  }
                }
              }
            }
          }
        ]
      }
    },
    {
      "$comment": "Court:Court.CourtAddressCountValidation | FinancialOfficeAddressCountValidation | WelshCourtAddressCountValidation",
      "if": {
        "properties": {
          "lja_type": {
            "enum": [
              "NICRT",
              "SCSCRT",
              "SJCRT"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "addresses": {
            "minItems": 1,
            "contains": {
              "properties": {
                "address_type": {
                  "const": "Court Address"
                }
              },
              "required": [
                "address_type"
              ]
            },
            "minContains": 1,
            "maxContains": 1,
            "not": {
              "type": "null"
            }
          }
        },
        "required": [
          "addresses"
        ]
      }
    },
    {
      "$comment": "Court:Court.CourtAddressCountValidation | FinancialOfficeAddressCountValidation | WelshCourtAddressCountValidation",
      "if": {
        "properties": {
          "lja_type": {
            "enum": [
              "CRWCRT"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "addresses": {
            "minItems": 1,
            "contains": {
              "properties": {
                "address_type": {
                  "const": "Court Address"
                }
              },
              "required": [
                "address_type"
              ]
            },
            "minContains": 1,
            "maxContains": 1,
            "not": {
              "type": "null"
            }
          }
        },
        "required": [
          "addresses"
        ],
        "allOf": [
          {
            "$comment": "Court:Court.WelshCourtAddressCountValidation",
            "if": {
              "required": [
                "lja_welsh_name"
              ],
              "properties": {
                "lja_welsh_name": {
                  "not": {
                    "type": "null"
                  }
                }
              }
            },
            "then": {
              "properties": {
                "addresses": {
                  "contains": {
                    "properties": {
                      "address_type": {
                        "const": "Welsh Court Address"
                      }
                    },
                    "required": [
                      "address_type"
                    ]
                  },
                  "minContains": 1,
                  "maxContains": 1,
                  "not": {
                    "type": "null"
                  }
                }
              },
              "required": [
                "addresses"
              ]
            },
            "else": {
              "properties": {
                "addresses": {
                  "not": {
                    "contains": {
                      "properties": {
                        "address_type": {
                          "const": "Welsh Court Address"
                        }
                      },
                      "required": [
                        "address_type"
                      ]
                    }
                  }
                }
              }
            }
          }
        ]
      }
    }
  ]
}
