{
  "title": "Court record",
  "type": "object",
  "properties": {
    "court_location_code": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 10
    },
    "pss_common_platform_court_id": {
      "type": [
        "integer",
        "null"
      ]
    },
    "common_platform_uuid": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "draft_final_exists_indicator": {
      "type": "boolean"
    },
    "revision_type": {
      "type": "string",
      "enum": [
        "Initial",
        "New",
        "Edit"
      ],
      "maxLength": 7
    },
    "scottish_district_court_indicator": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "pss_national_courthouse_id": {
      "type": [
        "integer",
        "null"
      ]
    },
    "northern_ireland_court_indicator": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "current_record_indicator": {
      "type": "boolean"
    },
    "cloned_from": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 128
    },
    "authoring_status": {
      "type": "string",
      "enum": [
        "Draft",
        "Final",
        "Published",
        "Not Draft"
      ],
      "maxLength": 128
    },
    "court_welsh_name": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 100
    },
    "pss_common_platform_id": {
      "type": [
        "integer",
        "null"
      ]
    },
    "court_type": {
      "type": "string",
      "enum": [
        "CHOA"
      ],
      "maxLength": 6
    },
    "pss_central_finance_location_id": {
      "type": [
        "integer",
        "null"
      ]
    },
    "welsh_indicator": {
      "type": "string",
      "enum": [
        "true",
        "false"
      ],
      "maxLength": 5
    },
    "crown_court_indicator": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "pss_change_set_header_id": {
      "type": [
        "integer",
        "null"
      ]
    },
    "notes": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 4000
    },
    "magistrates_court_indicator": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "scottish_sheriff_court_indicator": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "court_name": {
      "type": "string",
      "maxLength": 100
    },
    "cja_code": {
      "type": "string",
      "enum": [
        "41",
        "53",
        "55",
        "13",
        "60",
        "04",
        "35",
        "06",
        "40",
        "16",
        "03",
        "44",
        "21",
        "62",
        "07",
        "30",
        "42",
        "33",
        "50",
        "45",
        "36",
        "22",
        "17",
        "12",
        "54",
        "46",
        "47",
        "31",
        "10",
        "63",
        "01",
        "23",
        "52",
        "37",
        "34",
        "11",
        "61",
        "05",
        "14",
        "32",
        "43",
        "20"
      ],
      "maxLength": 2
    },
    "psscmaid": {
      "type": [
        "integer",
        "null"
      ]
    },
    "scottish_justice_of_peace_court_indicator": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "pss_welsh_link_address_id": {
      "type": [
        "integer",
        "null"
      ]
    },
    "default_duration": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 10,
      "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]$"
    },
    "default_start_time": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 10,
      "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]$"
    },
    "revision_number": {
      "type": "integer"
    },
    "court_hearing_operation_area_indicator": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "youth_court_indicator": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "revision_date_to": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "pss_welsh_address_id": {
      "type": [
        "integer",
        "null"
      ]
    },
    "revision_date_from": {
      "type": "string",
      "format": "date"
    },
    "publishing_status": {
      "type": "string",
      "enum": [
        "Superseded",
        "Future",
        "Active",
        "Inactive",
        "Submitted",
        "Not Published",
        "Added to Release Package",
        "Error"
      ],
      "maxLength": 128
    },
    "division_code": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "4",
        "6",
        "1",
        "5",
        "2",
        "7",
        "3",
        null
      ],
      "maxLength": 20
    },
    "pss_location_id": {
      "type": [
        "integer",
        "null"
      ]
    },
    "cluster_information_code": {
      "type": [
        "integer",
        "null"
      ]
    },
    "court_lja_header_code": {
      "type": [
        "integer",
        "null"
      ]
    },
    "venue_code": {
      "type": [
        "integer",
        "null"
      ]
    },
    "enforcement_area_code": {
      "type": [
        "integer",
        "null"
      ]
    },
    "court_code": {
      "type": [
        "integer",
        "null"
      ]
    },
    "release_package_code": {
      "type": [
        "integer",
        "null"
      ]
    },
    "region_code": {
      "type": [
        "integer",
        "null"
      ]
    },
    "address": {
      "type": [
        "array",
        "null"
      ],
      "minItems": 0,
      "items": {
        "$ref": "#/$defs/address"
      }
    },
    "contact_information": {
      "type": [
        "array",
        "null"
      ],
      "minItems": 0,
      "items": {
        "$ref": "#/$defs/contactInformation"
      }
    }
  },
  "required": [
    "draft_final_exists_indicator",
    "revision_type",
    "current_record_indicator",
    "authoring_status",
    "court_type",
    "welsh_indicator",
    "court_name",
    "revision_number",
    "revision_date_from",
    "publishing_status",
    "cja_code"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "welsh_indicator": {
            "enum": [
              "true"
            ]
          }
        },
        "required": [
          "welsh_indicator"
        ]
      },
      "then": {
        "required": [
          "court_welsh_name"
        ],
        "properties": {
          "court_welsh_name": {
            "not": {
              "type": "null"
            }
          }
        }
      }
    },
    {
      "$comment": "Court:Court.CourtLocationCodeCrownValidation | CourtLocationCodeMagistratesValidation (per stepper)",
      "if": {
        "properties": {
          "court_location_code": {
            "pattern": "^C"
          }
        }
      },
      "then": {
        "required": [
          "court_location_code"
        ],
        "properties": {
          "court_location_code": {
            "pattern": "^C(?:01|03|04|05|06|07|10|11|12|13|14|16|17|20|21|22|23|30|31|32|33|34|35|36|37|40|41|42|43|44|45|46|47|50|52|53|54|55|60|61|62|63)[A-Z]{2}\\d{2}$",
            "not": {
              "type": "null"
            }
          }
        }
      },
      "else": {
        "required": [
          "court_location_code"
        ],
        "properties": {
          "court_location_code": {
            "pattern": "^B(?:01|03|04|05|06|07|10|11|12|13|14|16|17|20|21|22|23|30|31|32|33|34|35|36|37|40|41|42|43|44|45|46|47|50|52|53|54|55|60|61|62|63)[A-Z]{2}\\d{2}$",
            "not": {
              "type": "null"
            }
          }
        }
      }
    }
  ]
}
