{
  "title": "Court record",
  "type": "object",
  "properties": {
    "court_name": {
      "type": "string",
      "maxLength": 100
    },
    "court_welsh_name": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 100
    },
    "court_location_code": {
      "type": "string",
      "maxLength": 10,
      "$comment": "Court:Court.CourtLocationCodeCrownValidation | CourtLocationCodeMagistratesValidation (per stepper)",
      "if": {
        "pattern": "^C"
      },
      "then": {
        "pattern": "^C(?:01|03|04|05|06|07|10|11|12|13|14|16|17|20|21|22|23|30|31|32|33|34|35|36|37|40|41|42|43|44|45|46|47|50|52|53|54|55|60|61|62|63)[A-Z]{2}\\d{2}$"
      },
      "else": {
        "pattern": "^B(?:01|03|04|05|06|07|10|11|12|13|14|16|17|20|21|22|23|30|31|32|33|34|35|36|37|40|41|42|43|44|45|46|47|50|52|53|54|55|60|61|62|63)[A-Z]{2}\\d{2}$"
      },
      "x-unique-keys": [
        {
          "name": "CourtLocationCodeUniqueKey"
        }
      ]
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "end_date": {
      "type": [
        "string",
        "null"
      ],
      "format": "date",
      "x-rules": [
        {
          "name": "EndDateNotEarlierThanStartDate",
          "op": ">=",
          "right": "start_date",
          "compare_as": "date"
        }
      ]
    },
    "cja_code": {
      "type": "string",
      "enum": [
        "41",
        "53",
        "55",
        "13",
        "60",
        "04",
        "35",
        "06",
        "40",
        "16",
        "03",
        "44",
        "21",
        "62",
        "07",
        "30",
        "42",
        "33",
        "50",
        "45",
        "36",
        "22",
        "17",
        "12",
        "54",
        "46",
        "47",
        "31",
        "10",
        "63",
        "01",
        "23",
        "52",
        "37",
        "34",
        "11",
        "61",
        "05",
        "14",
        "32",
        "43",
        "20"
      ]
    },
    "division_code": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "4",
        "6",
        "1",
        "5",
        "2",
        "7",
        "3",
        null
      ]
    },
    "default_start_time": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 10,
      "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]$"
    },
    "default_duration": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 10,
      "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]$"
    },
    "common_platform_uuid": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "notes": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 4000
    },
    "publishing_status": {
      "type": "string",
      "enum": [
        "Superseded",
        "Future",
        "Active",
        "Inactive",
        "Submitted",
        "Not Published",
        "Added to Release Package",
        "Error"
      ]
    },
    "addresses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/address"
      },
      "allOf": [
        {
          "contains": {
            "properties": {
              "address_type": {
                "const": "Court Address"
              }
            },
            "required": [
              "address_type"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        }
      ]
    },
    "contact_information": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "#/$defs/contactInformation"
      }
    }
  },
  "required": [
    "court_name",
    "start_date",
    "publishing_status",
    "cja_code",
    "addresses",
    "court_location_code"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "$comment": "Court:Court.WelshCourtAddressCountValidation",
      "if": {
        "required": [
          "court_welsh_name"
        ],
        "properties": {
          "court_welsh_name": {
            "not": {
              "type": "null"
            }
          }
        }
      },
      "then": {
        "properties": {
          "addresses": {
            "contains": {
              "properties": {
                "address_type": {
                  "const": "Welsh Court Address"
                }
              },
              "required": [
                "address_type"
              ]
            },
            "minContains": 1,
            "maxContains": 1
          }
        }
      },
      "else": {
        "properties": {
          "addresses": {
            "not": {
              "contains": {
                "properties": {
                  "address_type": {
                    "const": "Welsh Court Address"
                  }
                },
                "required": [
                  "address_type"
                ]
              }
            }
          }
        }
      }
    }
  ]
}
