{
  "title": "Central authority record",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "maxLength": 4000
    },
    "welsh_name": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 4000
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "end_date": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "publishing_status": {
      "type": "string",
      "enum": [
        "Future",
        "Error",
        "Submitted",
        "Inactive",
        "Superseded",
        "Active",
        "Not Published",
        "Added to Release Package"
      ],
      "maxLength": 128
    },
    "addresses": {
      "type": [
        "array",
        "null"
      ],
      "minItems": 0,
      "items": {
        "$ref": "#/$defs/orgAddress"
      }
    },
    "contact_information": {
      "type": [
        "array",
        "null"
      ],
      "minItems": 0,
      "items": {
        "$ref": "#/$defs/orgContactInformation"
      }
    }
  },
  "required": [
    "name",
    "publishing_status",
    "start_date"
  ],
  "additionalProperties": false,
  "x-unique-keys": [
    {
      "name": "CentralAuthoritiesUniqueKey",
      "key": [
        "name"
      ]
    }
  ],
  "x-rules": [
    {
      "name": "EndDateNotEarlierThanStartDateValidation",
      "left": "end_date",
      "op": ">=",
      "right": "start_date",
      "compare_as": "date"
    }
  ]
}
